{
  "name": "bookmark-manager",
  "version": "1.0.3",
  "description": "书签管家 · Chrome MV3 书签管理扩展（零构建，纯原生 JS）",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint js/ --ext .js",
    "lint:fix": "eslint js/ --ext .js --fix",
    "format": "prettier --write \"js/**/*.js\" \"css/*.css\" \"*.html\"",
    "check:sync": "node scripts/check-native-sync.js",
    "release": "node scripts/release.js",
    "check-version": "node scripts/release.js --check"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.14.0",
    "globals": "^17.11.0",
    "prettier": "^3.3.3",
    "vitest": "^2.1.0"
  }
}
